table Interventions
	lineageTag: 7c09af9e-d9c3-4ced-aaff-bb8f167aa168

	column Athlete
		dataType: string
		lineageTag: 0157ec8c-ae3d-4de4-8085-49e49a381ba9
		summarizeBy: none
		sourceColumn: Athlete

		annotation SummarizationSetBy = Automatic

	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 18c77ad4-ff97-4628-b4a3-e36f5096272f
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column Note
		dataType: string
		lineageTag: ca8e6454-8c78-4bce-bd2b-6465d14afce5
		summarizeBy: none
		sourceColumn: Note

		annotation SummarizationSetBy = Automatic

	partition Interventions = m
		mode: import
		source =
				// Interventions log: one row per change you made for an athlete. It draws a marker on that
				// athlete's trend charts (page 2) and lists the note in the Interventions card.
				// Edit it in Power Query (Transform data > Interventions > the gear on "Source"), or replace it
				// with a table from Excel. Type the athlete exactly as the report shows the name
				// (athlete_01 ... while AnonymizeNames is true).
				let
				    Source = #table(
				        type table [Athlete = text, Date = date, Note = text],
				        {
				            {"athlete_01", #date(2026, 7, 20), "Example: training modified"}
				        })
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
