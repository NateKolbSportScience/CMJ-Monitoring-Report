	measure 'Pos Impulse Better' =
			-- green marker: this test is better than normal by more than the SWC and more than 0.5 SD (a positive adaptation)
			IF(NOT ISBLANK([Pos Impulse Trend]) && ([Pos Impulse Trend] - [Pos Impulse Normal]) > [Pos Impulse SWC] && [Pos Impulse z] > 0.5, [Pos Impulse Trend])
		formatString: 0
		displayFolder: Individual trend\3 Positive impulse
		lineageTag: ba18746b-1ce8-4df2-b0bd-005c5c98d841

	measure 'Pos Impulse Change' =
			-- tooltip: difference from the athlete's normal (or the team normal until they have one)
			IF(NOT ISBLANK([Pos Impulse Trend]), [Pos Impulse Trend] - COALESCE([Pos Impulse Normal], [Pos Impulse Team Normal]))
