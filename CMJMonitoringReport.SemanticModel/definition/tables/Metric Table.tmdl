			IF(NOT ISBLANK([Ecc Dur Trend]), IF(ISBLANK([Ecc Dur Normal]), "Building own baseline (compared with the team)", IF([Ecc Dur Beyond SWC] && [Ecc Dur z] < -0.5, "Flag", IF(NOT ISBLANK([Ecc Dur Better]), "Improved", "Normal"))))
		displayFolder: Individual trend\5 Eccentric duration
