				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","Force at Zero Velocity","Force at Zero Velocity [N]",Replacer.ReplaceText,{"Metric"})
				in
				    #"Replaced Value2"

	annotation PBI_ResultType = Table

