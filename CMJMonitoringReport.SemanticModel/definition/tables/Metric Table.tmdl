			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < TestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
