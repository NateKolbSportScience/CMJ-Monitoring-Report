			IF(NOT ISBLANK([Ecc Dur Trend]) && ([Ecc Dur Normal] - [Ecc Dur Trend]) > [Ecc Dur SWC] && [Ecc Dur z] > 0.5, [Ecc Dur Trend])
		formatString: 0
