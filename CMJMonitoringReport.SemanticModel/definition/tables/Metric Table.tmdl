			IF(NOT ISBLANK([Pos Impulse Trend]), IF(ISBLANK([Pos Impulse Normal]), "Building own baseline (compared with the team)", IF([Pos Impulse Beyond SWC] && [Pos Impulse z] < -0.5, "Flag", IF(NOT ISBLANK([Pos Impulse Better]), "Improved", "Normal"))))
		displayFolder: Individual trend\3 Positive impulse
