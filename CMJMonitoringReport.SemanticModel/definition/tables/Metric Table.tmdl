	measure 'Selected Metric 2' =
			
			VAR LatestDate = MAX('CMJ Data'[Date])
			
			RETURN
			SWITCH(
			    SELECTEDVALUE('Metric Table'[Metric]),
			    "Jump Height (Imp-Mom)[cm]", CALCULATE(MAX('CMJ Data'[Jump Height (Imp-Mom) (cm)]), 'CMJ Data'[Date] = LatestDate),
			    "Peak Power / BM [W/kg]", CALCULATE(MAX('CMJ Data'[Peak Power / BM (W/kg)]), 'CMJ Data'[Date] = LatestDate),
			    "Concentric Impulse % (Asym) ", CALCULATE(MAX('CMJ Data'[Concentric Impulse % (Asym) Direction]), 'CMJ Data'[Date] = LatestDate),
			    "Eccentric Braking Impulse (Asym) %", CALCULATE(MAX('CMJ Data'[Eccentric Braking Impulse % (Asym) Direction]), 'CMJ Data'[Date] = LatestDate),
			    "Contraction Time [ms]", CALCULATE(MAX('CMJ Data'[Contraction Time (ms)]), 'CMJ Data'[Date] = LatestDate),
			    "Force at Zero Velocity [N]", CALCULATE(MAX('CMJ Data'[Force at Zero Velocity (N)]), 'CMJ Data'[Date] = LatestDate),
			    "Vertical Velocity at Takeoff [m/s]", CALCULATE(MAX('CMJ Data'[Vertical Velocity at Takeoff (m/s)]), 'CMJ Data'[Date] = LatestDate),
			    "CMJ Stiffness [N/m]", CALCULATE(MAX('CMJ Data'[CMJ Stiffness [N/m]] ]), 'CMJ Data'[Date] = LatestDate),
			    "Eccentric Braking RFD [N/s]", CALCULATE(MAX('CMJ Data'[Eccentric Braking RFD (N/s)]), 'CMJ Data'[Date] = LatestDate),
			    "Eccentric Duration [ms]", CALCULATE(MAX('CMJ Data'[Eccentric Duration (ms)]), 'CMJ Data'[Date] = LatestDate),
			    "Countermovement Depth [cm]", CALCULATE(MAX('CMJ Data'[Countermovement Depth [cm]] ]), 'CMJ Data'[Date] = LatestDate),
			    BLANK()
			)
		lineageTag: 159bdabf-8135-4f3e-93ed-9f4114f72d4d

