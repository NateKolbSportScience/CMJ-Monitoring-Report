				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Metric", type text}, {"Category", type text}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Changed Type","Peak Power/ BM [W/kg]","Peak Power / BM [W/kg]",Replacer.ReplaceText,{"Metric"}),
