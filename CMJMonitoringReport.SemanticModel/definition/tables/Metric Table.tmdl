	measure 'Selected Metric ZScore' = ```
			
			 VAR MetricValue =
			 SWITCH(
			    SELECTEDVALUE('Metric Table'[Metric]),
			     "Jump Height (Imp-Mom)[cm]", MAX('rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)]),
			    "Peak Power / BM [W/kg]", MAX('rtp_latestCMJ'[Peak Power / BM (W/kg)]),
			    "Eccentric Braking Impulse (Asym) %", MAX('rtp_latestCMJ'[Eccentric Braking Impulse % (Asym) Direction]),
			    "Contraction Time [ms]", MAX('rtp_latestCMJ'[Contraction Time (ms)]),
			    "Force at Zero Velocity [N]", MAX('rtp_latestCMJ'[Force at Zero Velocity (N)]),
			    "Vertical Velocity at Takeoff [m/s]", MAX('rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)]),
			    BLANK()
			 )
			 VAR MetricMean =
			  SWITCH(
			    SELECTEDVALUE('Metric Table'[Metric]),
			    "Jump Height (Imp-Mom)[cm]", AVERAGE('rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)]),
			    "Peak Power / BM [W/kg]", AVERAGE('rtp_latestCMJ'[Peak Power / BM (W/kg)]),
			    "Eccentric Braking Impulse (Asym) %", AVERAGE('rtp_latestCMJ'[Eccentric Braking Impulse % (Asym) Direction]),
			    "Contraction Time [ms]", AVERAGE('rtp_latestCMJ'[Contraction Time (ms)]),
			    "Force at Zero Velocity [N]", AVERAGE('rtp_latestCMJ'[Force at Zero Velocity (N)]),
			    "Vertical Velocity at Takeoff [m/s]", AVERAGE('rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)]),
			    BLANK()
			 )
			 VAR MetricStdDev =
			 SWITCH(
			    SELECTEDVALUE('Metric Table'[Metric]),
			    "Jump Height (Imp-Mom)[cm]", STDEV.P('rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)]),
			    "Peak Power / BM [W/kg]", STDEV.P('rtp_latestCMJ'[Peak Power / BM (W/kg)]),
			    "Eccentric Braking Impulse (Asym) %", STDEV.P('rtp_latestCMJ'[Eccentric Braking Impulse % (Asym) Direction]),
			    "Contraction Time [ms]", STDEV.P('rtp_latestCMJ'[Contraction Time (ms)]),
			    "Force at Zero Velocity [N]", STDEV.P('rtp_latestCMJ'[Force at Zero Velocity (N)]),
			    "Vertical Velocity at Takeoff [m/s]", STDEV.P('rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)]),
			    BLANK()
			 )
			
			 RETURN
			 IF(
			    NOT(ISBLANK(MetricValue)),
			    (MetricValue - MetricMean) / MetricStdDev,
			    BLANK()
			   
			 )
			```
		lineageTag: 8eeb2be2-cbf5-42cd-95c8-51b8940df730

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Metric ZScore Color' = ```
			
			VAR CurrentAthlete = SELECTEDVALUE('rtp_latestCMJ'[Name])
			
			VAR LatestDate = 
			    CALCULATE(
			        MAX('rtp_latestCMJ'[Date]),
			        'rtp_latestCMJ'[Name] = CurrentAthlete
			    )
			
			VAR SelectedMetric = SELECTEDVALUE('Metric Table'[Metric])
			
			VAR MetricValue =
			    SWITCH(
			        SelectedMetric,
			        "Jump Height (Imp-Mom)[cm]", CALCULATE(MAX('rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)]), 'rtp_latestCMJ'[Date] = LatestDate),
			        "Peak Power / BM [W/kg]", CALCULATE(MAX('rtp_latestCMJ'[Peak Power / BM (W/kg)]), 'rtp_latestCMJ'[Date] = LatestDate),
			        "Eccentric Braking Impulse (Asym) %", CALCULATE(MAX('rtp_latestCMJ'[Eccentric Braking Impulse % (Asym) Direction]), 'rtp_latestCMJ'[Date] = LatestDate),
			        "Contraction Time [ms]", CALCULATE(MAX('rtp_latestCMJ'[Contraction Time (ms)]), 'rtp_latestCMJ'[Date] = LatestDate),
			        "Force at Zero Velocity [N]", CALCULATE(MAX('rtp_latestCMJ'[Force at Zero Velocity (N)]), 'rtp_latestCMJ'[Date] = LatestDate),
			        "Vertical Velocity at Takeoff [m/s]", CALCULATE(MAX('rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)]), 'rtp_latestCMJ'[Date] = LatestDate),
			        BLANK()
			    )
			
			VAR MetricMean =
			    SWITCH(
			        SelectedMetric,
			        "Jump Height (Imp-Mom)[cm]", CALCULATE(AVERAGE('rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Peak Power / BM [W/kg]", CALCULATE(AVERAGE('rtp_latestCMJ'[Peak Power / BM (W/kg)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Eccentric Braking Impulse (Asym) %", CALCULATE(AVERAGE('rtp_latestCMJ'[Eccentric Braking Impulse % (Asym) Direction]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Contraction Time [ms]", CALCULATE(AVERAGE('rtp_latestCMJ'[Contraction Time (ms)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Force at Zero Velocity [N]", CALCULATE(AVERAGE('rtp_latestCMJ'[Force at Zero Velocity (N)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Vertical Velocity at Takeoff [m/s]", CALCULATE(AVERAGE('rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        BLANK()
			    )
			
			VAR MetricStdDev =
			    SWITCH(
			        SelectedMetric,
			        "Jump Height (Imp-Mom)[cm]", CALCULATE(STDEV.P('rtp_latestCMJ'[Jump Height (Imp-Mom) (cm)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Peak Power / BM [W/kg]", CALCULATE(STDEV.P('rtp_latestCMJ'[Peak Power / BM (W/kg)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Eccentric Braking Impulse (Asym) %", CALCULATE(STDEV.P('rtp_latestCMJ'[Eccentric Braking Impulse % (Asym) Direction]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Contraction Time [ms]", CALCULATE(STDEV.P('rtp_latestCMJ'[Contraction Time (ms)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Force at Zero Velocity [N]", CALCULATE(STDEV.P('rtp_latestCMJ'[Force at Zero Velocity (N)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        "Vertical Velocity at Takeoff [m/s]", CALCULATE(STDEV.P('rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)]), ALL('rtp_latestCMJ'[Date]), 'rtp_latestCMJ'[Name] = CurrentAthlete),
			        BLANK()
			    )
			
			VAR ZScore =
			    IF(
			        NOT(ISBLANK(MetricValue)) && MetricStdDev <> 0,
			        (MetricValue - MetricMean) / MetricStdDev,
			        BLANK()
			    )
			
			-- Flip Z-score for lower-is-better metrics so red still means bad
			VAR DirectedZ =
			    IF(
			        SelectedMetric = "Contraction Time [ms]" || SelectedMetric = "Eccentric Braking Impulse (Asym) %",
			        ZScore * -1,
			        ZScore
			    )
			
			RETURN
			    IF(
			        NOT(ISBLANK(DirectedZ)),
			        SWITCH(
			            TRUE(),
			            DirectedZ >= -0.5,  "#2ECC71",  -- Green: within 0.5 SD of average or above
			            DirectedZ >= -1.0,  "#F4D03F",  -- Yellow: 0.5 to 1 SD below average
			            "#E74C3C"                        -- Red: more than 1 SD below average
			        ),
			        BLANK()
			    )
			```
		lineageTag: 8dd63dfd-d9ad-4900-bf10-6c567914aa64

	measure 'ZScore Debug' = ```
			
