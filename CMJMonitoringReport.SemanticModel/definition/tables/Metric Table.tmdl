		isHidden
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: b96eb171-9a2c-4e45-ae0f-9b37a3079b61

	measure 'CM Depth Team Normal' =
			-- stand-in normal while the athlete has fewer than [Min Baseline Tests] earlier tests: the team's average
			-- over the 28 days before this test (same season). Drawn as a dotted line. Tests are not flagged against it,
			-- because comparing one athlete with the team mostly reflects ability, not readiness.
			VAR TestDate = MAX('CMJ Data'[Date])
			VAR Team =
			    CALCULATE(
			        AVERAGE('CMJ Data'[Countermovement Depth [cm]] ]),
			        REMOVEFILTERS('CMJ Data'), REMOVEFILTERS('athleteid'), VALUES('CMJ Data'[Season]),
			        'CMJ Data'[Date] < TestDate, 'CMJ Data'[Date] >= TestDate - 28
			    )
			RETURN
			    IF(NOT ISBLANK([CM Depth Trend]) && ISBLANK([CM Depth Normal]), Team)
		formatString: 0.0
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: 3dce1772-dcca-4a78-9fba-6835ea8e1237

	measure 'CM Depth SWC +' =
			-- smallest worthwhile change band around the athlete's normal (or the team normal until they have one)
			VAR N = COALESCE([CM Depth Normal], [CM Depth Team Normal])
			RETURN IF(NOT ISBLANK(N), N + [CM Depth SWC])
		formatString: 0.0
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: 2d0ae3e9-dffe-40c8-88f1-8f2b971f6727

	measure 'CM Depth SWC -' =
			-- smallest worthwhile change band around the athlete's normal (or the team normal until they have one)
			VAR N = COALESCE([CM Depth Normal], [CM Depth Team Normal])
			RETURN IF(NOT ISBLANK(N), N - [CM Depth SWC])
		formatString: 0.0
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: 78681d3c-1c97-4010-b974-9aa85140ae9b

	measure 'CM Depth z' =
			-- how far this test sits from normal in SD units (a big change in either direction counts as worse); negative = worse
			-ABS(DIVIDE([CM Depth Trend] - [CM Depth Normal], [CM Depth SD]))
		formatString: 0.00
		isHidden
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: 5cdf06a2-bf79-400a-bf78-e04181c42036

	measure 'CM Depth CV %' =
			-- day-to-day noise for this athlete: SD as a % of their mean
			-- blank until one athlete is picked on page 2
			IF(HASONEVALUE('athleteid'[Name]),
			    CALCULATE(DIVIDE(STDEV.P('CMJ Data'[Countermovement Depth [cm]] ]), ABS(AVERAGE('CMJ Data'[Countermovement Depth [cm]] ]))) * 100, REMOVEFILTERS('CMJ Data'[Date]))
			)
		formatString: 0.0
		displayFolder: Individual trend\Noise (CV %)
		lineageTag: 904d7469-1533-4393-8692-759d1fbee0fb

	measure 'Ecc Asym Trend' =
			-- eccentric braking impulse asymmetry, L - / R +
			-- blank until one athlete is picked on page 2
			IF(HASONEVALUE('athleteid'[Name]),
			    AVERAGE('CMJ Data'[Eccentric Braking Impulse % (Asym) Direction])
			)
		formatString: 0.0
		displayFolder: Individual trend\Asymmetry
		lineageTag: b56ca300-c95a-44e4-912c-598c577e2de9

	measure 'Conc Asym Trend' =
			-- concentric impulse asymmetry, L - / R +
			-- blank until one athlete is picked on page 2
			IF(HASONEVALUE('athleteid'[Name]),
			    AVERAGE('CMJ Data'[Concentric Impulse % (Asym) Direction])
			)
		formatString: 0.0
		displayFolder: Individual trend\Asymmetry
		lineageTag: 9b7af15f-0898-4460-bb44-aef2e224d1e0

	measure 'Asym Guide +' =
			-- +10% guide line
			IF(NOT ISBLANK([Ecc Asym Trend]), 10)
		formatString: 0
		displayFolder: Individual trend\Asymmetry
		lineageTag: 52a1716c-e8cc-4158-a7a6-e53d7f691864

	measure 'Asym Guide -' =
			-- -10% guide line
			IF(NOT ISBLANK([Ecc Asym Trend]), -10)
		formatString: 0
		displayFolder: Individual trend\Asymmetry
		lineageTag: 84e6da16-3e14-4cbc-826f-54af585ef177

	measure 'JH Flag' =
			-- red marker: worse than the SWC and more than 0.5 SD from the athlete's normal
			VAR Z = [JH z]
			RETURN IF([JH Beyond SWC] && Z < -0.5, [JH Trend])
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: 670a3833-187d-452a-bcd9-b8e05ab7b54e

	measure 'JH Better' =
			-- green marker: this test is better than normal by more than the SWC and more than 0.5 SD (a positive adaptation)
			IF(NOT ISBLANK([JH Trend]) && ([JH Trend] - [JH Normal]) > [JH SWC] && [JH z] > 0.5, [JH Trend])
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: 190984a2-dce1-4bd6-ac75-51fbabe6c01a

	measure 'JH Change' =
			-- tooltip: difference from the athlete's normal (or the team normal until they have one)
			IF(NOT ISBLANK([JH Trend]), [JH Trend] - COALESCE([JH Normal], [JH Team Normal]))
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: 87624f05-0a82-429e-a944-c1ea38ea6143

	measure 'JH Status' =
			-- tooltip: Flag, Improved, Normal, or building own baseline
			IF(NOT ISBLANK([JH Trend]), IF(ISBLANK([JH Normal]), "Building own baseline (compared with the team)", IF([JH Beyond SWC] && [JH z] < -0.5, "Flag", IF(NOT ISBLANK([JH Better]), "Improved", "Normal"))))
		displayFolder: Individual trend\1 Jump height
		lineageTag: 152e493b-7f84-47f1-8c62-deb25e916c00

	measure 'PP/BM Flag' =
			-- red marker: worse than the SWC and more than 0.5 SD from the athlete's normal
			VAR Z = [PP/BM z]
			RETURN IF([PP/BM Beyond SWC] && Z < -0.5, [PP/BM Trend])
		formatString: 0.0
		displayFolder: Individual trend\2 Peak power per BM
		lineageTag: 099cef44-aa05-4f6a-9eed-6a17331d963b

	measure 'PP/BM Better' =
