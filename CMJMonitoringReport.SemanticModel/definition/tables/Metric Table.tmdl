	measure 'CM Depth Flag' =
			-- red marker: worse than the SWC and more than 0.5 SD from the athlete's normal
			VAR Z = [CM Depth z]
			RETURN IF([CM Depth Beyond SWC] && Z < -0.5, [CM Depth Trend])
		formatString: 0.0
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: 91f0c4eb-35a5-496a-957c-f7822043a9af

	measure 'CM Depth Change' =
			-- tooltip: difference from the athlete's normal (or the team normal until they have one)
			IF(NOT ISBLANK([CM Depth Trend]), [CM Depth Trend] - COALESCE([CM Depth Normal], [CM Depth Team Normal]))
		formatString: 0.0
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: 408b6d74-871e-4a6e-b983-079c8e49827c

	measure 'CM Depth Status' =
			-- tooltip: Flag, Improved, Normal, or building own baseline
			IF(NOT ISBLANK([CM Depth Trend]), IF(ISBLANK([CM Depth Normal]), "Building own baseline (compared with the team)", IF([CM Depth Beyond SWC] && [CM Depth z] < -0.5, "Flag", "Normal")))
		displayFolder: Individual trend\6 Countermovement depth
		lineageTag: b4768d1e-1359-4d15-9b0b-af7f63845c65

	measure 'BW Trend' =
			-- body weight at each test (kg). Relative metrics like PP/BM move with it
			-- blank until one athlete is picked on page 2
			IF(HASONEVALUE('athleteid'[Name]),
			    AVERAGE('CMJ Data'[BW [KG]]])
			)
		formatString: 0.0
		displayFolder: Individual trend\7 Body weight
		lineageTag: b3807f43-8383-4ac1-a845-99a676d44976

	measure 'BW Normal' =
			-- the athlete's normal body weight at this test: mean of their previous tests (rolling window)
			VAR TestDate = MAX('CMJ Data'[Date])
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < TestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			RETURN
			    IF(NOT ISBLANK([BW Trend]) && COUNTROWS(PriorDates) >= [Min Baseline Tests], AVERAGEX(PriorDates, CALCULATE(AVERAGE('CMJ Data'[BW [KG]]]))))
		formatString: 0.0
		displayFolder: Individual trend\7 Body weight
		lineageTag: 25115fab-d916-457c-a768-4251a312ba40

	measure 'Baseline Tests' =
			-- TUNE: how many of the athlete's previous tests make up their normal (rolling window)
			10
		formatString: 0
		displayFolder: Settings
		lineageTag: d34c8586-5235-448b-b395-8cec1dc04fa3

	measure 'Baseline Lag' =
			-- TUNE: how many of the athlete's most recent tests are held out of their normal. With 3, a test is compared
			-- with the [Baseline Tests] tests before the last three, so a problem building over a few weeks still stands out
			-- instead of blending into the normal. 0 = plain rolling window. Phased in until there is enough history.
			3
		formatString: 0
		displayFolder: Settings
		lineageTag: 780f8cba-ae12-4ba4-a9c9-309371bb99bd

	measure 'Min Baseline Tests' =
			-- TUNE: an athlete needs at least this many previous tests before they are scored
			3
		formatString: 0
		displayFolder: Settings
		lineageTag: 21284cb2-256b-46fa-bba9-11e8840accce

	measure 'As Of Label' =
			-- shown under the week slider: the week the page is showing and the Monday it starts
			VAR Wk = MAX('CMJ Data'[Week])
			VAR WeekStart = CALCULATE(MIN('CMJ Data'[Date]), 'CMJ Data'[Week] = Wk, ALL('athleteid'))
			VAR Monday = WeekStart - WEEKDAY(WeekStart, 3)
			RETURN "Showing week " & Wk & "  ·  w/c " & FORMAT(Monday, "d mmm yyyy")
		displayFolder: Summary
		lineageTag: c94d15f6-8fed-4655-9f68-9eb3c7c086fc

