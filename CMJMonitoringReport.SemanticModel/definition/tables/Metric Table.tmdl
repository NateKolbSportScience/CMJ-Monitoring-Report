	measure 'CT Flag' =
			-- red marker: worse than the SWC and more than 0.5 SD from the athlete's normal
			VAR Z = [CT z]
			RETURN IF([CT Beyond SWC] && Z < -0.5, [CT Trend])
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 45945f16-bcba-4f6c-8754-0b5ade1ad23b

	measure 'CT Better' =
			-- green marker: this test is better than normal by more than the SWC and more than 0.5 SD (a positive adaptation)
			IF(NOT ISBLANK([CT Trend]) && ([CT Normal] - [CT Trend]) > [CT SWC] && [CT z] > 0.5, [CT Trend])
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 0727b1c8-2f08-4384-9d9b-824a4a3527cf

	measure 'CT Change' =
			-- tooltip: difference from the athlete's normal (or the team normal until they have one)
			IF(NOT ISBLANK([CT Trend]), [CT Trend] - COALESCE([CT Normal], [CT Team Normal]))
		formatString: 0.0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 0999f6ab-e273-4a6e-a90d-a5a0a6809777

	measure 'CT Status' =
			-- tooltip: Flag, Improved, Normal, or building own baseline
			IF(NOT ISBLANK([CT Trend]), IF(ISBLANK([CT Normal]), "Building own baseline (compared with the team)", IF([CT Beyond SWC] && [CT z] < -0.5, "Flag", IF(NOT ISBLANK([CT Better]), "Improved", "Normal"))))
		displayFolder: Individual trend\4 Contraction time
