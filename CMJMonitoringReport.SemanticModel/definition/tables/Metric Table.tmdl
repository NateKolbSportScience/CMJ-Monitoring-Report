	measure 'z Takeoff Vel (m/s)' =
			-- latest test vs this athlete's own tests up to the as-of date, in SD units (negative = worse)
			VAR LatestDate = MAX('rtp_latestCMJ'[Date])
			VAR Hist = 'rtp_latestCMJ'
			VAR Cur = AVERAGEX(FILTER(Hist, 'rtp_latestCMJ'[Date] = LatestDate), 'rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)])
			VAR Mu = AVERAGEX(Hist, 'rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)])
			VAR Sd = STDEVX.P(Hist, 'rtp_latestCMJ'[Vertical Velocity at Takeoff (m/s)])
			VAR Z = DIVIDE(Cur - Mu, Sd)
