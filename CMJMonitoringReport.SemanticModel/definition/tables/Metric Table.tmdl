			IF(NOT ISBLANK([PP/BM Trend]) && ([PP/BM Trend] - [PP/BM Normal]) > [PP/BM SWC] && [PP/BM z] > 0.5, [PP/BM Trend])
		formatString: 0.0
		displayFolder: Individual trend\2 Peak power per BM
		lineageTag: 7f53aaf3-0a7f-42c3-871e-02de7a874f58

	measure 'PP/BM Change' =
			-- tooltip: difference from the athlete's normal (or the team normal until they have one)
			IF(NOT ISBLANK([PP/BM Trend]), [PP/BM Trend] - COALESCE([PP/BM Normal], [PP/BM Team Normal]))
		formatString: 0.0
		displayFolder: Individual trend\2 Peak power per BM
		lineageTag: 3fa859d8-a375-44de-b11e-68bb2fe96a63

	measure 'PP/BM Status' =
			-- tooltip: Flag, Improved, Normal, or building own baseline
			IF(NOT ISBLANK([PP/BM Trend]), IF(ISBLANK([PP/BM Normal]), "Building own baseline (compared with the team)", IF([PP/BM Beyond SWC] && [PP/BM z] < -0.5, "Flag", IF(NOT ISBLANK([PP/BM Better]), "Improved", "Normal"))))
		displayFolder: Individual trend\2 Peak power per BM
		lineageTag: 0a8cd5c9-b645-4f75-a2b3-57074b01fd0f

	measure 'Pos Impulse Flag' =
