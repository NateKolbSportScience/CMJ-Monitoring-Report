	measure 'PP/BM SWC' =
			-- smallest worthwhile change (Hopkins 2004): 0.2 x the between-athlete SD (spread of every athlete's normal)
			0.2 * CALCULATE(STDEVX.P(VALUES('athleteid'[Name]), CALCULATE(AVERAGE('CMJ Data'[Peak Power / BM (W/kg)]))), REMOVEFILTERS('athleteid'), REMOVEFILTERS('CMJ Data'), VALUES('CMJ Data'[Season]))
		formatString: 0.00
		isHidden
		displayFolder: Individual trend\2 Peak power per BM
