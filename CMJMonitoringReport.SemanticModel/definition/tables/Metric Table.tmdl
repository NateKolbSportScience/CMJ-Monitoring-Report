		isHidden
		displayFolder: Readiness SWC
		lineageTag: 34be08fb-edb0-4edc-a357-c08c4c7ed5a6

	measure 'level Ecc Dur (ms)' =
			-- 2 = red, 1 = amber, 0 = green. A cell only turns amber or red when the change is worse than the
			-- SWC AND bigger than this athlete's normal noise (amber 0.5-1.5 SD, red more than 1.5 SD; Hopkins: act on individual change past ~1.5-2x noise)
			VAR LatestDate = MAX('CMJ Data'[Date])
			-- normal = the athlete's previous tests only (up to [Baseline Tests] of them), never the test being judged
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < LatestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			VAR Cur = CALCULATE(AVERAGE('CMJ Data'[Eccentric Duration (ms)]), 'CMJ Data'[Date] = LatestDate)
			VAR Mu = AVERAGEX(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Eccentric Duration (ms)])))
			VAR Change = Mu - Cur    -- negative = worse
			VAR Z = [z Ecc Dur (ms)]
			VAR SWC = [SWC Ecc Dur (ms)]
			RETURN
			    SWITCH(TRUE(), ISBLANK(Z), BLANK(), Change >= -SWC, 0, Z < -1.5, 2, Z < -0.5, 1, 0)
		formatString: 0
		isHidden
		displayFolder: Readiness SWC
		lineageTag: aa8a00c5-44ad-4012-8644-f1ab364f7903

	measure 'colour Selected Metric' =
			-- bar colour for the asymmetry and strategy charts, using the same rules and palette as the grid
			VAR L =
			    SWITCH(
			        SELECTEDVALUE('Metric Table'[Metric]),
			        "Contraction Time [ms]", [level CT (ms)],
			        "Eccentric Duration [ms]", [level Ecc Dur (ms)],
			        "Countermovement Depth [cm]", [level CM Depth (cm)],
			        "Eccentric Braking Impulse (Asym) %", [level Ecc Asym],
			        "Concentric Impulse (Asym) %", [level Conc Asym]
			    )
			RETURN
			    SWITCH(TRUE(), ISBLANK(L), "#55604D", L = 2, "#F07167", L = 1, "#F2C14E", "#6CC28A")
		isHidden
		displayFolder: Readiness colours
		lineageTag: c6ad1db6-0f6f-4153-b281-0b01d558d851

	measure 'level Ecc Asym' =
			-- 2 = red, 1 = amber, 0 = green for the asymmetry bar chart. Worse = a bigger asymmetry (either side) than the
			-- athlete's previous tests, by more than the SWC AND by more than their normal noise. Same rules as the grid.
			VAR LatestDate = MAX('CMJ Data'[Date])
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < LatestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			VAR Cur = ABS(CALCULATE(AVERAGE('CMJ Data'[Eccentric Braking Impulse % (Asym) Direction]), 'CMJ Data'[Date] = LatestDate))
			VAR Mu = AVERAGEX(PriorDates, ABS(CALCULATE(AVERAGE('CMJ Data'[Eccentric Braking Impulse % (Asym) Direction]))))
			VAR Sd = STDEVX.P(PriorDates, ABS(CALCULATE(AVERAGE('CMJ Data'[Eccentric Braking Impulse % (Asym) Direction]))))
			VAR SWC = 0.2 * STDEVX.P(ALL('athleteid'[Name]), CALCULATE(AVERAGEX('CMJ Data', ABS('CMJ Data'[Eccentric Braking Impulse % (Asym) Direction]))))
			VAR Z = DIVIDE(Mu - Cur, Sd)
			RETURN
			    SWITCH(TRUE(), ISBLANK(Cur) || COUNTROWS(PriorDates) < [Min Baseline Tests] || ISBLANK(Z), BLANK(), Mu - Cur >= -SWC, 0, Z < -1.5, 2, Z < -0.5, 1, 0)
		formatString: 0
		isHidden
		displayFolder: Readiness SWC
		lineageTag: 68d2825a-f690-4ecd-bb7b-9152c25d3fdd

	measure 'level Conc Asym' =
			-- 2 = red, 1 = amber, 0 = green for the asymmetry bar chart. Worse = a bigger asymmetry (either side) than the
			-- athlete's previous tests, by more than the SWC AND by more than their normal noise. Same rules as the grid.
			VAR LatestDate = MAX('CMJ Data'[Date])
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < LatestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			VAR Cur = ABS(CALCULATE(AVERAGE('CMJ Data'[Concentric Impulse % (Asym) Direction]), 'CMJ Data'[Date] = LatestDate))
			VAR Mu = AVERAGEX(PriorDates, ABS(CALCULATE(AVERAGE('CMJ Data'[Concentric Impulse % (Asym) Direction]))))
			VAR Sd = STDEVX.P(PriorDates, ABS(CALCULATE(AVERAGE('CMJ Data'[Concentric Impulse % (Asym) Direction]))))
			VAR SWC = 0.2 * STDEVX.P(ALL('athleteid'[Name]), CALCULATE(AVERAGEX('CMJ Data', ABS('CMJ Data'[Concentric Impulse % (Asym) Direction]))))
			VAR Z = DIVIDE(Mu - Cur, Sd)
			RETURN
			    SWITCH(TRUE(), ISBLANK(Cur) || COUNTROWS(PriorDates) < [Min Baseline Tests] || ISBLANK(Z), BLANK(), Mu - Cur >= -SWC, 0, Z < -1.5, 2, Z < -0.5, 1, 0)
		formatString: 0
		isHidden
		displayFolder: Readiness SWC
		lineageTag: 5a31d1da-46c7-4741-8bb6-1f51baee354b

	measure 'Flagged Athletes' =
			-- MONITOR (red): athletes scoring 12+ points (see Readiness Points)
			COUNTROWS(FILTER(VALUES('athleteid'[Name]), [Readiness Score] = 2)) + 0
		formatString: 0
		displayFolder: Summary
		lineageTag: 3ce925bb-42c4-41c6-ba0f-3477236c2f63

	measure 'Readiness Points' =
			-- each box on page 1 scores points: watch (amber) = 1, red = 2.
			-- strategy boxes (CT, eccentric duration, CM depth) and eccentric braking asymmetry count double: watch = 2, red = 4,
			-- because how an athlete jumps (and loads each leg) can shift before output drops. Max = 3 x 2 + 4 x 4 = 22.
			IF(
			    NOT ISBLANK([level JH (cm)]),
			    COALESCE([level JH (cm)], 0) + COALESCE([level PP/BM (W/kg)], 0) + COALESCE([level Pos Impulse (N s)], 0)
			        + 2 * (COALESCE([level CT (ms)], 0) + COALESCE([level Ecc Dur (ms)], 0) + COALESCE([level CM Depth (cm)], 0) + COALESCE([level Ecc Asym], 0))
			)
		formatString: 0
		displayFolder: Summary
		lineageTag: 3c454293-d463-4c2e-aa8a-708afcd70162

	measure 'Readiness Score' =
			-- 0-6 points = FINE (green), 7-11 = CAUTION (yellow), 12+ = MONITOR (red). See Readiness Points.
			VAR P = [Readiness Points]
			RETURN
			    SWITCH(TRUE(), ISBLANK(P), BLANK(), P >= 12, 2, P >= 7, 1, 0)
		formatString: 0
		isHidden
		displayFolder: Summary
		lineageTag: 747dcb63-b681-4255-84c2-9a2d6cea4426

	measure 'Readiness Status' = IF(ISBLANK(MAX('CMJ Data'[Date])), BLANK(), IF(ISBLANK([Readiness Score]), "Building baseline (fewer than 3 earlier tests)", SWITCH([Readiness Score], 2, "Monitor", 1, "Caution", 0, "Fine")))
		displayFolder: Summary
		lineageTag: 1289a534-c0e7-45a6-a642-fb942edd32a2

	measure 'colour Athlete Name' =
			-- athlete name colour on page 1: red = monitor, yellow = caution, green = fine
			SWITCH([Readiness Score], 2, "#F07167", 1, "#F2C14E", 0, "#6CC28A", "#8E9681")
		isHidden
		displayFolder: Readiness colours
		lineageTag: 28ec9c4b-df72-4e7b-a4ee-081673df20de

	measure 'Status Icon' =
			-- icon beside the athlete name on page 1: check engine light = monitor, caution triangle = caution, nothing = fine
			SWITCH(
			    [Readiness Score],
			    2, "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 24'><path d='M6 8 H10 V5.5 H7.5 V3 H18.5 V5.5 H16 V8 H21 L23.5 11 H26 V7.5 H29 V19.5 H26 V16 H23.5 L21 20 H10 L8 18 H6 V15.5 H3.5 V18.5 H1 V8.5 H3.5 V11.5 H6 Z' fill='%23F07167'/></svg>",
			    1, "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 24'><path d='M16 1.5 L29 22.5 H3 Z' fill='%23F2C14E' stroke='%23F2C14E' stroke-linejoin='round' stroke-width='1.5'/><rect x='14.9' y='8' width='2.2' height='8' rx='1' fill='%232F3A2A'/><circle cx='16' cy='19' r='1.3' fill='%232F3A2A'/></svg>",
			    BLANK()
			)
		isHidden
		displayFolder: Readiness colours
		lineageTag: 16b5c6dc-43b7-415e-bbe5-240664b9d034
		dataCategory: ImageUrl

	measure 'Tested This Week' =
			VAR AsOf = CALCULATE(MAX('CMJ Data'[Date]), ALL('athleteid'))
			VAR Tested =
			    COUNTROWS(FILTER(VALUES('athleteid'[Name]), CALCULATE(MAX('CMJ Data'[Date])) > AsOf - 7))
			-- athletes tested at least once this season (up to the selected week)
			VAR Total = COUNTROWS(FILTER(VALUES('athleteid'[Name]), NOT ISBLANK(CALCULATE(MAX('CMJ Data'[Date])))))
			RETURN
			    FORMAT(Tested, "0") & " / " & FORMAT(Total, "0")
		displayFolder: Summary
		lineageTag: 4ea62125-376b-4fa7-8bf3-4df5739a79b7

	measure 'Pos Impulse (N s)' =
			VAR LatestDate = MAX('CMJ Data'[Date])
			RETURN
			    CALCULATE(AVERAGE('CMJ Data'[Positive Impulse [N s]] ]), 'CMJ Data'[Date] = LatestDate)
		formatString: 0
		displayFolder: Output
		lineageTag: b3fe3628-020a-4892-a2a8-2e07e3154b63

	measure 'z Pos Impulse (N s)' =
			-- latest test vs the athlete's previous tests, in SD units (negative = worse)
			VAR LatestDate = MAX('CMJ Data'[Date])
			-- normal = the athlete's previous tests only (up to [Baseline Tests] of them), never the test being judged
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < LatestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			VAR Cur = CALCULATE(AVERAGE('CMJ Data'[Positive Impulse [N s]] ]), 'CMJ Data'[Date] = LatestDate)
			VAR Mu = AVERAGEX(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Positive Impulse [N s]] ])))
			VAR Sd = STDEVX.P(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Positive Impulse [N s]] ])))
			VAR Z = DIVIDE(Cur - Mu, Sd)
			RETURN
			    IF(ISBLANK(Cur) || COUNTROWS(PriorDates) < [Min Baseline Tests] || ISBLANK(Z), BLANK(), Z)
		formatString: 0.00
		isHidden
		displayFolder: Readiness z-scores
		lineageTag: 76dca2c0-82da-4c37-97e6-397b4a25ec4e

	measure 'colour Pos Impulse (N s)' =
			VAR L = [level Pos Impulse (N s)]
			RETURN
			    SWITCH(TRUE(), ISBLANK(L), "#3A4633", L = 2, "#F07167", L = 1, "#F2C14E", "#6CC28A")
		isHidden
		displayFolder: Readiness colours
		lineageTag: 55a8f469-4e36-46e5-ba1a-4fcca49e51bf

	measure 'SWC Pos Impulse (N s)' =
			-- smallest worthwhile change (Hopkins 2004): 0.2 x the between-athlete SD,
			-- i.e. the spread of every athlete's normal (their mean) up to the as-of date
			0.2 * STDEVX.P(ALL('athleteid'[Name]), CALCULATE(AVERAGE('CMJ Data'[Positive Impulse [N s]] ])))
		formatString: 0
		isHidden
		displayFolder: Readiness SWC
		lineageTag: f2bd8192-edee-4db0-b574-cfbe9c8fa0a9

	measure 'level Pos Impulse (N s)' =
			-- 2 = red, 1 = amber, 0 = green. A cell only turns amber or red when the change is worse than the
			-- SWC AND bigger than this athlete's normal noise (amber 0.5-1.5 SD, red more than 1.5 SD; Hopkins: act on individual change past ~1.5-2x noise)
			VAR LatestDate = MAX('CMJ Data'[Date])
			-- normal = the athlete's previous tests only (up to [Baseline Tests] of them), never the test being judged
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < LatestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			VAR Cur = CALCULATE(AVERAGE('CMJ Data'[Positive Impulse [N s]] ]), 'CMJ Data'[Date] = LatestDate)
			VAR Mu = AVERAGEX(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Positive Impulse [N s]] ])))
			VAR Change = Cur - Mu    -- negative = worse
			VAR Z = [z Pos Impulse (N s)]
			VAR SWC = [SWC Pos Impulse (N s)]
			RETURN
			    SWITCH(TRUE(), ISBLANK(Z), BLANK(), Change >= -SWC, 0, Z < -1.5, 2, Z < -0.5, 1, 0)
		formatString: 0
		isHidden
		displayFolder: Readiness SWC
		lineageTag: ba66e25c-459e-4c22-abf3-1e33751dca93

	measure 'JH Trend' =
			-- the athlete's test value on each date (average of the reps exported for that test)
			-- blank until one athlete is picked on page 2
			IF(HASONEVALUE('athleteid'[Name]),
			    AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)])
			)
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: 9256e744-c2b9-4e5d-abae-8d34e7aa8c3c

	measure 'JH Normal' =
			-- the athlete's normal at this test: mean of their previous tests (rolling window), never including this one
			VAR TestDate = MAX('CMJ Data'[Date])
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < TestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			RETURN
			    IF(NOT ISBLANK([JH Trend]) && COUNTROWS(PriorDates) >= [Min Baseline Tests], AVERAGEX(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]))))
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: 5eb03018-a8c9-49c4-b328-0346abaa41d6

	measure 'JH SD' =
			-- the athlete's normal day-to-day bounce at this test: SD of the same previous tests
			VAR TestDate = MAX('CMJ Data'[Date])
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < TestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			RETURN
			    IF(COUNTROWS(PriorDates) >= [Min Baseline Tests], STDEVX.P(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]))))
		formatString: 0.0
		isHidden
		displayFolder: Individual trend\1 Jump height
		lineageTag: 20a1eaa5-c53e-40a4-834e-c6a819d78180

	measure 'JH SWC' =
			-- smallest worthwhile change (Hopkins 2004): 0.2 x the between-athlete SD (spread of every athlete's normal)
			0.2 * CALCULATE(STDEVX.P(VALUES('athleteid'[Name]), CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]))), REMOVEFILTERS('athleteid'), REMOVEFILTERS('CMJ Data'), VALUES('CMJ Data'[Season]))
		formatString: 0.0
		isHidden
		displayFolder: Individual trend\1 Jump height
		lineageTag: 6a1ec60f-4b30-4e6b-aae0-edab40eb57ef

	measure 'JH Beyond SWC' =
			-- TRUE when this test is worse than normal by more than the SWC
			NOT ISBLANK([JH Normal]) && ([JH Trend] - [JH Normal]) < -[JH SWC]
		isHidden
		displayFolder: Individual trend\1 Jump height
		lineageTag: b23100fa-fc2a-45b1-8079-2149d0278ce8

	measure 'JH Team Normal' =
			-- stand-in normal while the athlete has fewer than [Min Baseline Tests] earlier tests: the team's average
			-- over the 28 days before this test (same season). Drawn as a dotted line. Tests are not flagged against it,
			-- because comparing one athlete with the team mostly reflects ability, not readiness.
			VAR TestDate = MAX('CMJ Data'[Date])
			VAR Team =
			    CALCULATE(
			        AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]),
			        REMOVEFILTERS('CMJ Data'), REMOVEFILTERS('athleteid'), VALUES('CMJ Data'[Season]),
			        'CMJ Data'[Date] < TestDate, 'CMJ Data'[Date] >= TestDate - 28
			    )
			RETURN
			    IF(NOT ISBLANK([JH Trend]) && ISBLANK([JH Normal]), Team)
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: 8c936f0a-7dda-4ad8-a883-747e55244b2d

	measure 'JH SWC +' =
			-- smallest worthwhile change band around the athlete's normal (or the team normal until they have one)
			VAR N = COALESCE([JH Normal], [JH Team Normal])
			RETURN IF(NOT ISBLANK(N), N + [JH SWC])
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: cbf088ce-b08a-4b70-b639-268c7d40ce77

	measure 'JH SWC -' =
			-- smallest worthwhile change band around the athlete's normal (or the team normal until they have one)
			VAR N = COALESCE([JH Normal], [JH Team Normal])
			RETURN IF(NOT ISBLANK(N), N - [JH SWC])
		formatString: 0.0
		displayFolder: Individual trend\1 Jump height
		lineageTag: df1331f2-73cf-478c-a086-7a9d0f4a225f

	measure 'JH z' =
			-- how far this test sits from normal in SD units (higher is better); negative = worse
			DIVIDE([JH Trend] - [JH Normal], [JH SD])
		formatString: 0.00
		isHidden
		displayFolder: Individual trend\1 Jump height
		lineageTag: fd947d4a-4a11-45cb-80bc-17df91076098

	measure 'JH CV %' =
			-- day-to-day noise for this athlete: SD as a % of their mean
			-- blank until one athlete is picked on page 2
			IF(HASONEVALUE('athleteid'[Name]),
			    CALCULATE(DIVIDE(STDEV.P('CMJ Data'[Jump Height (Imp-Mom) (cm)]), ABS(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]))) * 100, REMOVEFILTERS('CMJ Data'[Date]))
