	measure 'JH (cm)' =
			VAR LatestDate = MAX('CMJ Data'[Date])
			RETURN
			    CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]), 'CMJ Data'[Date] = LatestDate)
		formatString: 0.0
		displayFolder: Output
		lineageTag: 028473e6-2e75-4251-9596-ad48c6255fe5

	measure 'z JH (cm)' =
			-- latest test vs the athlete's previous tests, in SD units (negative = worse)
			VAR LatestDate = MAX('CMJ Data'[Date])
			-- normal = the athlete's previous tests only (up to [Baseline Tests] of them), never the test being judged
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < LatestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			VAR Cur = CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]), 'CMJ Data'[Date] = LatestDate)
			VAR Mu = AVERAGEX(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)])))
			VAR Sd = STDEVX.P(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)])))
			VAR Z = DIVIDE(Cur - Mu, Sd)
			RETURN
			    IF(ISBLANK(Cur) || COUNTROWS(PriorDates) < [Min Baseline Tests] || ISBLANK(Z), BLANK(), Z)
		formatString: 0.00
		isHidden
		displayFolder: Readiness z-scores
		lineageTag: cbc027a3-0940-4a32-bbfa-e2b6a1dd0b04

	measure 'colour JH (cm)' =
			VAR L = [level JH (cm)]
			RETURN
			    SWITCH(TRUE(), ISBLANK(L), "#3A4633", L = 2, "#F07167", L = 1, "#F2C14E", "#6CC28A")
		isHidden
		displayFolder: Readiness colours
		lineageTag: efb81501-b2c3-4767-9617-21c93bf5ee69

	measure 'SWC JH (cm)' =
			-- smallest worthwhile change (Hopkins 2004): 0.2 x the between-athlete SD,
			-- i.e. the spread of every athlete's normal (their mean) up to the as-of date
			0.2 * STDEVX.P(ALL('athleteid'[Name]), CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)])))
		formatString: 0.0
		isHidden
		displayFolder: Readiness SWC
		lineageTag: f965c293-609c-48e7-a676-6244ed96a88e

	measure 'level JH (cm)' =
			-- 2 = red, 1 = amber, 0 = green. A cell only turns amber or red when the change is worse than the
			-- SWC AND bigger than this athlete's normal noise (amber 0.5-1.5 SD, red more than 1.5 SD; Hopkins: act on individual change past ~1.5-2x noise)
			VAR LatestDate = MAX('CMJ Data'[Date])
			-- normal = the athlete's previous tests only (up to [Baseline Tests] of them), never the test being judged
			-- normal = previous tests, holding out the most recent [Baseline Lag] so a slow build-up isn't absorbed
			VAR AllPrior = CALCULATETABLE(VALUES('CMJ Data'[Date]), REMOVEFILTERS('CMJ Data'[Week]), 'CMJ Data'[Date] < LatestDate)
			VAR RecentHeld = MAX(0, MIN([Baseline Lag], COUNTROWS(AllPrior) - [Min Baseline Tests]))
			VAR PriorDates = TOPN([Baseline Tests], EXCEPT(AllPrior, TOPN(RecentHeld, AllPrior, 'CMJ Data'[Date], DESC)), 'CMJ Data'[Date], DESC)
			VAR Cur = CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)]), 'CMJ Data'[Date] = LatestDate)
			VAR Mu = AVERAGEX(PriorDates, CALCULATE(AVERAGE('CMJ Data'[Jump Height (Imp-Mom) (cm)])))
			VAR Change = Cur - Mu    -- negative = worse
			VAR Z = [z JH (cm)]
			VAR SWC = [SWC JH (cm)]
			RETURN
			    SWITCH(TRUE(), ISBLANK(Z), BLANK(), Change >= -SWC, 0, Z < -1.5, 2, Z < -0.5, 1, 0)
		formatString: 0
		isHidden
		displayFolder: Readiness SWC
		lineageTag: 0213691c-2ae6-4529-85fe-75387464e133

