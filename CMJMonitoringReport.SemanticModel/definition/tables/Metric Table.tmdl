			VAR Athlete = SELECTEDVALUE('athleteid'[Name])
			VAR TestDate = MAX('rtp_latestCMJ'[Date])
			VAR HasEntry = NOT ISEMPTY(FILTER(ALL('Interventions'), 'Interventions'[Athlete] = Athlete && 'Interventions'[Date] = TestDate))
			RETURN IF(HasEntry && NOT ISBLANK([Pos Impulse Trend]), [Pos Impulse Trend])
		formatString: 0
		displayFolder: Individual trend\3 Positive impulse
		lineageTag: e9e6c55b-cf3a-424e-88da-f997ff95022e

	measure 'Pos Impulse CV %' =
			-- day-to-day noise for this athlete: SD as a % of their mean
			CALCULATE(DIVIDE(STDEV.P('rtp_latestCMJ'[Positive Impulse [N s]] ]), ABS(AVERAGE('rtp_latestCMJ'[Positive Impulse [N s]] ]))) * 100, REMOVEFILTERS('rtp_latestCMJ'[Date]))
		formatString: 0.0
		displayFolder: Individual trend\Noise (CV %)
		lineageTag: 97f5d788-fdd6-4e68-8922-9cf42f55ff67

	measure 'CT Trend' =
			-- the athlete's test value on each date (average of the reps exported for that test)
			AVERAGE('rtp_latestCMJ'[Contraction Time (ms)])
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 86327a74-4ef6-4bd8-922b-eb25f626bc72

	measure 'CT Normal' =
			-- the athlete's normal: mean of all their tests
			IF(
			    NOT ISBLANK([CT Trend]),
			    CALCULATE(AVERAGE('rtp_latestCMJ'[Contraction Time (ms)]), REMOVEFILTERS('rtp_latestCMJ'[Date]))
			)
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: fe752d0a-5a28-4bbb-836a-f0473059943d

	measure 'CT SD' =
			CALCULATE(STDEV.P('rtp_latestCMJ'[Contraction Time (ms)]), REMOVEFILTERS('rtp_latestCMJ'[Date]))
		formatString: 0
		isHidden
		displayFolder: Individual trend\4 Contraction time
		lineageTag: e9b0c827-f878-4a73-b4d2-b54c83032de0

	measure 'CT SWC +' =
			-- smallest worthwhile change band: normal +/- 0.5 x the athlete's own SD
			IF(NOT ISBLANK([CT Trend]), [CT Normal] + 0.5 * [CT SD])
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 8b5ac7e9-5df0-4020-9ffb-eaee29317670

	measure 'CT SWC -' =
			IF(NOT ISBLANK([CT Trend]), [CT Normal] - 0.5 * [CT SD])
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 65f49018-333e-4cb0-b6f4-b4ff108ae536

	measure 'CT z' =
			-- how far this test sits from normal in SD units (lower is better, so the sign is flipped); negative = worse
			-DIVIDE([CT Trend] - [CT Normal], [CT SD])
		formatString: 0.00
		isHidden
		displayFolder: Individual trend\4 Contraction time
		lineageTag: fb9142e7-fafe-4b57-b248-c28d928df6cb

	measure 'CT Amber' =
			-- plotted as an amber marker when the test is 0.5-1 SD worse than normal (beyond SWC)
			VAR Z = [CT z]
			RETURN IF(NOT ISBLANK([CT Trend]) && Z < -0.5 && Z >= -1, [CT Trend])
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 98ddcc2d-dfd4-48ee-a9b6-799de7e150a5

	measure 'CT Red' =
			-- plotted as a red marker when the test is more than 1 SD worse than normal
			VAR Z = [CT z]
			RETURN IF(NOT ISBLANK([CT Trend]) && Z < -1, [CT Trend])
		formatString: 0
		displayFolder: Individual trend\4 Contraction time
		lineageTag: 914b6141-24ae-4896-b239-1d2b605a7b2a

